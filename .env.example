# Client-side public Supabase config (safe for browser)
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side AI config (set in Vercel Environment Variables WITHOUT VITE_ prefix in production)
AI_PROVIDER=fallback
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# Optional: enables permanent auth user deletion via /api/account
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
